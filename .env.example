# Core runtime
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Required in production for NextAuth token/session signing.
# Generate with: openssl rand -base64 32
# (The desktop app ignores this and generates its own per install.)
NEXTAUTH_SECRET=replace-with-strong-random-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olly?schema=public
# Used by Prisma for direct DB operations (migrations/introspection)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/olly?schema=public
# Strongly recommended: enables field-level encryption for OAuth tokens and
# connector credentials. Generate from apps/web with: npx cloak generate
# (The desktop app ignores this and generates its own per install.)
PRISMA_FIELD_ENCRYPTION_KEY=replace-with-32-byte-key

# Cron (Vercel route handlers)
CRON_ENABLED=true
CRON_SECRET=replace-with-long-random-cron-secret

# Authentication (required)
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# LLM provider selection
# Valid values: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Legacy fallback used in some paths
OPENAI_TEMPERATURE=0.2

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-flash-latest

# Slack integration (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional override (comma-separated). If unset, app defaults are used.
SLACK_SCOPES=search:read,channels:history,groups:history,im:history,mpim:history,users:read

# Notion, Jira and Airtable need no app-level credentials. Each user pastes
# their own token on the Integrations page.

# Web Push notifications (optional, self-hosted server only)
# Generate a keypair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or https: URL that identifies the operator.
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability / telemetry (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
METRICS_AGGREGATES_ENABLED=true
DEBUG_AI_SDK=false

