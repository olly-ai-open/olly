# Core runtime
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Required in production for NextAuth token/session signing
NEXTAUTH_SECRET=replace-with-strong-random-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olly?schema=public
# Used by Prisma for direct DB operations (migrations/introspection)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/olly?schema=public
# Optional but recommended: enables field-level encryption for sensitive columns
PRISMA_FIELD_ENCRYPTION_KEY=replace-with-32-byte-key

# Cron (Vercel route handlers)
CRON_ENABLED=true
CRON_SECRET=replace-with-long-random-cron-secret

# Authentication (required)
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# LLM provider selection
# Valid values: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Legacy fallback used in some paths
OPENAI_TEMPERATURE=0.2

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251202

# Gemini
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Slack integration (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional override (comma-separated). If unset, app defaults are used.
SLACK_SCOPES=search:read,channels:history,groups:history,im:history,mpim:history,users:read

# Notion integration (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Web Push notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability / telemetry (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
METRICS_AGGREGATES_ENABLED=true
DEBUG_AI_SDK=false

