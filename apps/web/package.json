{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,tsc \"next dev\" \"node scripts/dev-typecheck.mjs\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "postinstall": "prisma generate",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "precommit": "lint-staged",
    "typecheck": "node scripts/ensure-next-types.mjs && tsc --noEmit",
    "typecheck:watch": "node scripts/ensure-next-types.mjs && tsc -w --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@olly/core": "file:../../packages/core",
    "@prisma/client": "6.18.0",
    "@supabase/supabase-js": "^2.77.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "googleapis": "^164.1.0",
    "humanize-duration": "3.33.1",
    "lucide-react": "0.556.0",
    "newrelic": "^13.8.0",
    "next": "15.5.7",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.7.0",
    "prisma": "6.18.0",
    "prisma-field-encryption": "^1.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@47ng/cloak": "^1.2.0",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.18.0",
    "@tailwindcss/postcss": "^4",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
