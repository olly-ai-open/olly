// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth base models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  preferences   Json?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  integrations  Integration[]
  actionItems   ActionItem[]
  meetings      Meeting[]
  jobs          Job[]
  schedules     Schedule[]
  cached        CachedArtifact[]
  people        Person[]
  driveFolders  DriveFolder[]
  settings      UserSettings?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text /// @encrypted
  access_token       String? @db.Text /// @encrypted
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text /// @encrypted
  session_state      String?
  oauth_token_secret String? @db.Text /// @encrypted
  oauth_token        String? @db.Text /// @encrypted

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Product models
model Integration {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  scopes    String?
  status    String
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, provider])
}

model Meeting {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  attendees  Json?
  type       String?
  status     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefs Brief[]
  participants MeetingParticipant[]

  @@unique([userId, externalId], name: "userId_externalId")
  @@index([startsAt])
}

model Brief {
  id          String   @id @default(cuid())
  meetingId   String
  content     Json
  confidence  String?
  sources     Json?
  generatedAt DateTime @default(now())
  feedback    Json?
  readAt      DateTime?
  
  // Debug data fields
  debugS3Key       String?
  debugCapturedAt  DateTime?
  debugMetadata    Json?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  people  BriefParticipant[]
  actionItems ActionItem[]

  @@index([meetingId, generatedAt])
}

model ActionItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  sourceRef Json?
  dueAt     DateTime?
  priority  String?
  status    String?
  completedAt DateTime?
  briefId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  brief Brief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  assignees ActionItemAssignee[]

  @@index([userId, status, dueAt])
}

model Job {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  status    String
  attempts  Int      @default(0)
  lastError String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  userId    String?
  runAt     DateTime?
  scheduleId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([status, runAt])
}

model Schedule {
  id         String   @id @default(cuid())
  userId     String
  type       String
  timeZone   String?
  timeOfDay  String   // HH:MM in user's timezone
  daysOfWeek Json?    // Optional array of weekdays (0-6) or other pattern
  active     Boolean  @default(true)
  nextRunAt  DateTime?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([userId, type, active])
  @@index([nextRunAt])
}

model CachedArtifact {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  etag         String?
  lastModified DateTime?
  snippetHash  String?
  lastFetchAt  DateTime?
  meta         Json?
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
}

// People directory and associations
model Person {
  id        String   @id @default(cuid())
  userId    String
  email     String?
  name      String?
  title     String?
  org       String?
  avatarUrl String?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings MeetingParticipant[]
  briefs   BriefParticipant[]
  assigned ActionItemAssignee[]

  @@index([userId, email])
}

model MeetingParticipant {
  meetingId String
  personId  String
  role      String?
  status    String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
}

model BriefParticipant {
  briefId  String
  personId String

  brief  Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([briefId, personId])
}

model ActionItemAssignee {
  actionItemId String
  personId     String

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([actionItemId, personId])
}

// Google Drive folder permissions
model DriveFolder {
  id         String   @id @default(cuid())
  userId     String
  folderId   String   // Google Drive folder ID
  folderName String   // Display name of the folder
  parentId   String?  // Parent folder ID (for nested folders)
  path       String?  // Full path for display (e.g., "My Folder/Subfolder")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
}

// User settings and preferences
model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  
  // Search settings
  searchTimeframeDays Int @default(30) // How far back to search (1-180 days)
  searchStrategy      String? // Optional: LLM_ONLY, HEURISTIC_ONLY, LLM_AND_HEURISTIC
  briefSystemPrompt   String? @db.Text // Optional override for brief generation system prompt
  queryPlannerSystemPrompt String? @db.Text // Optional override for query planner system prompt
  morningBriefSystemPrompt String? @db.Text // Optional override for morning brief generation prompt
  endOfDayBriefSystemPrompt String? @db.Text // Optional override for end-of-day brief generation prompt
  timeZone            String? // Optional IANA timezone identifier (e.g. America/Los_Angeles)
  
  // Notification preferences
  emailNotifications Boolean @default(true)

  // Event ignore settings (e.g., titles to skip for briefs)
  ignoredEventPatterns Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
