// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin", "darwin-arm64", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  preferences   Json?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  integrations  Integration[]
  actionItems   ActionItem[]
  meetings      Meeting[]
  jobs          Job[]
  schedules     Schedule[]
  cached        CachedArtifact[]
  people        Person[]
  driveFolders  DriveFolder[]
  settings      UserSettings?
  webPushSubscriptions WebPushSubscription[]
  docGenRequests    DocGenRequest[]
  generatedDocs     GeneratedDocument[]
  templateProfiles  TemplateProfile[]
  credentials       Credential[]
  notionCredential  NotionCredential?
  schedulingRequests SchedulingRequest[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text /// @encrypted
  access_token       String? @db.Text /// @encrypted
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text /// @encrypted
  session_state      String?
  oauth_token_secret String? @db.Text /// @encrypted
  oauth_token        String? @db.Text /// @encrypted

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  scopes    String?
  status    String
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, provider])
}

model Meeting {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  title      String
  startsAt   DateTime
  endsAt     DateTime?
  attendees  Json?
  type       String?
  status     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefs Brief[]
  participants MeetingParticipant[]

  @@unique([userId, externalId], name: "userId_externalId")
  @@index([startsAt])
}

model Brief {
  id          String   @id @default(cuid())
  meetingId   String
  content     Json
  confidence  String?
  sources     Json?
  generatedAt DateTime @default(now())
  feedback    Json?
  readAt      DateTime?

  debugS3Key       String?
  debugCapturedAt  DateTime?
  debugMetadata    Json?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  people  BriefParticipant[]
  actionItems ActionItem[]

  @@index([meetingId, generatedAt])
}

model ActionItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  sourceRef Json?
  dueAt     DateTime?
  priority  String?
  status    String?
  completedAt DateTime?
  briefId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  brief Brief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  assignees ActionItemAssignee[]
  events ActionItemEvent[]

  @@index([userId, status, dueAt])
}

model ActionItemEvent {
  id           String   @id @default(cuid())
  userId       String
  actionItemId String
  type         String
  createdAt    DateTime @default(now())

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([actionItemId, createdAt])
}

model Job {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  status    String
  attempts  Int      @default(0)
  maxAttempts Int    @default(5)
  lastError String?
  lockedAt  DateTime?
  lockToken String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  userId    String?
  runAt     DateTime?
  scheduleId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([status, runAt])
  @@index([status, lockedAt])
  @@index([kind, userId, status])
}

model Schedule {
  id         String   @id @default(cuid())
  userId     String
  type       String
  timeZone   String?
  timeOfDay  String
  daysOfWeek Json?
  active     Boolean  @default(true)
  nextRunAt  DateTime?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([userId, type, active])
  @@index([nextRunAt])
}

model CachedArtifact {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  etag         String?
  lastModified DateTime?
  snippetHash  String?
  lastFetchAt  DateTime?
  meta         Json?
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  email     String?
  name      String?
  title     String?
  org       String?
  avatarUrl String?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings MeetingParticipant[]
  briefs   BriefParticipant[]
  assigned ActionItemAssignee[]
  schedulingAttendees SchedulingAttendee[]

  @@index([userId, email])
}

model MeetingParticipant {
  meetingId String
  personId  String
  role      String?
  status    String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
}

model BriefParticipant {
  briefId  String
  personId String

  brief  Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([briefId, personId])
}

model ActionItemAssignee {
  actionItemId String
  personId     String

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([actionItemId, personId])
}

model DriveFolder {
  id         String   @id @default(cuid())
  userId     String
  folderId   String
  folderName String
  parentId   String?
  path       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([userId])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique

  searchTimeframeDays Int @default(30)
  searchStrategy      String?
  briefSystemPrompt   String? @db.Text
  queryPlannerSystemPrompt String? @db.Text
  morningBriefSystemPrompt String? @db.Text
  endOfDayBriefSystemPrompt String? @db.Text
  timeZone            String?
  telemetryOptIn      Boolean @default(true)

  emailNotifications Boolean @default(true)
  webNotificationsEnabled Boolean @default(false)

  ignoredEventPatterns Json?

  // Scheduling preferences (standing constraints for Olly-arranged meetings)
  workingHoursStart        String? // "09:00" local to timeZone
  workingHoursEnd          String? // "17:00"
  workingDays              Json?   // ISO weekday numbers, e.g. [1,2,3,4,5]
  meetingBufferMinutes     Int     @default(0)
  minSchedulingNoticeHours Int     @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebPushSubscription {
  id       String   @id @default(cuid())
  userId   String
  endpoint String   @unique
  p256dh   String
  auth     String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentMetricsDaily {
  id               String   @id @default(cuid())
  day              DateTime
  agentName        String
  runs             Int      @default(0)
  successes        Int      @default(0)
  errors           Int      @default(0)
  totalDurationMs  Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([day, agentName])
  @@index([day])
}

model ToolMetricsDaily {
  id              String   @id @default(cuid())
  day             DateTime
  toolName        String
  operation       String
  calls           Int      @default(0)
  successes       Int      @default(0)
  errors          Int      @default(0)
  totalDurationMs Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([day, toolName, operation])
  @@index([day])
}

model DocGenRequest {
  id         String   @id @default(cuid())
  userId     String
  prompt     String   @db.Text
  intent     Json?
  status     String   @default("pending")
  progress   Json?
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   TemplateProfile?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  runs       DocGenRun[]
  document   GeneratedDocument?

  @@index([userId, status])
  @@index([createdAt])
}

model DocGenRun {
  id          String    @id @default(cuid())
  requestId   String
  stage       String
  status      String    @default("running")
  evidence    Json?
  findings    Json?
  error       String?
  metadata    Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  request     DocGenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, stage])
}

model GeneratedDocument {
  id            String    @id @default(cuid())
  requestId     String    @unique
  userId        String
  title         String
  docType       String
  content       Json
  citations     Json?
  openQuestions Json?
  format        String    @default("markdown")
  savedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  request       DocGenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, docType])
  @@index([createdAt])
}

model TemplateProfile {
  id             String   @id @default(cuid())
  userId         String?
  name           String
  description    String?
  docType        String
  templateSource String   @default("system")
  content        String   @db.Text
  structure      Json?
  mimeType       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       DocGenRequest[]

  @@index([userId, docType, isActive])
}

model NotionCredential {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String   @db.Text /// @encrypted
  workspaceId   String
  workspaceName String?
  botId         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Credential {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  data      String   @db.Text /// @encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, provider])
}

model SchedulingRequest {
  id              String  @id @default(cuid())
  userId          String
  title           String
  durationMinutes Int     @default(30)
  // DRAFT | AWAITING_REPLIES | NEGOTIATING | AWAITING_APPROVAL | READY_TO_BOOK | BOOKED | NEEDS_ATTENTION | CANCELLED
  status          String  @default("DRAFT")
  // Date window, preferred times of day, allowed weekdays, free-form notes
  constraints     Json?
  // Current round's candidate slots: [{ startISO, endISO }]
  proposedSlots   Json?
  round           Int     @default(0)
  gmailThreadId   String?
  // Short token embedded in email subjects so off-thread replies can be found
  referenceToken  String  @unique
  autoBook        Boolean @default(true)
  // Proceed autonomously when attendees counter-propose times INSIDE the date window
  autoAltTimes    Boolean @default(true)
  // Proceed autonomously when attendees counter-propose times OUTSIDE the date window
  autoAltDates    Boolean @default(false)
  // Attendee-suggested slots awaiting the owner's approval:
  // [{ startISO, endISO, suggestedBy }]
  pendingSlots    Json?
  bookedEventId   String?
  bookedSlot      Json?
  attentionReason String?
  lastPolledAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees SchedulingAttendee[]
  messages  SchedulingMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model SchedulingAttendee {
  id                 String  @id @default(cuid())
  requestId          String
  personId           String?
  email              String
  name               String?
  required           Boolean @default(true)
  // PENDING | ACCEPTED | DECLINED | COUNTERED
  responseStatus     String  @default("PENDING")
  // Slot acceptances and stated constraints parsed from their replies
  parsedAvailability Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  request SchedulingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  person  Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([requestId, email])
}

model SchedulingMessage {
  id             String   @id @default(cuid())
  requestId      String
  direction      String // outbound | inbound
  gmailMessageId String?
  fromEmail      String?
  snippet        String?  @db.Text
  parsedIntent   Json?
  round          Int?
  createdAt      DateTime @default(now())

  request SchedulingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, gmailMessageId])
  @@index([requestId, createdAt])
}