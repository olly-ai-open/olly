{
  "name": "olly",
  "version": "1.0.2",
  "description": "Olly AI Local Desktop App",
  "author": "Mihir Bapat",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run postinstall --workspace=apps/web",
    "build:web": "set NODE_OPTIONS=--max-old-space-size=8192 && npm run build --workspace=apps/web",
    "electron": "electron .",
    "electron:build": "npm run build:web && electron-builder",
    "dist:mac": "npm run build:web && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build:web && electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "asar": false,
    "files": [
      "electron/**/*",
      "apps/web/.next/standalone/**/*",
      "apps/web/.next/static/**/*",
      "apps/web/public/**/*",
      "apps/web/package.json",
      "packages/core/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/.env.local",
        "to": "apps/web/.env.local"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}