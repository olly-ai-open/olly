{
  "name": "olly-monorepo",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run postinstall --workspace=apps/web",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.olly.local",
    "productName": "Olly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "apps/web/.next/**/*",
      "apps/web/public/**/*",
      "apps/web/package.json",
      "packages/core/dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}