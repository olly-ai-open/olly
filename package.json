{
  "name": "olly",
  "version": "1.0.2",
  "description": "Olly AI Local Desktop App",
  "author": "Mihir Bapat",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run postinstall --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "electron": "electron .",
    "electron:build": "electron-builder",
    "dist:mac": "npm run build:web && electron-builder --mac --universal",
    "dist:win": "npm run build:web && electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.olly.local",
    "productName": "Olly",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "apps/web/.next/**/*",
      "apps/web/public/**/*",
      "apps/web/package.json",
      "packages/core/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/next",
        "to": "node_modules/next"
      },
      {
        "from": "node_modules/react",
        "to": "node_modules/react"
      },
      {
        "from": "node_modules/react-dom",
        "to": "node_modules/react-dom"
      },
      {
        "from": "apps/web/.next",
        "to": "apps/web/.next"
      },
      {
        "from": "apps/web/public",
        "to": "apps/web/public"
      },
      {
        "from": "apps/web/package.json",
        "to": "apps/web/package.json"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}