{
  "name": "olly",
  "version": "1.0.2",
  "description": "Olly AI Local Desktop App",
  "author": "Mihir Bapat",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run postinstall --workspace=apps/web",
    "build:web": "set NODE_OPTIONS=--max-old-space-size=8192 && npm run build --workspace=apps/web",
    "electron": "electron .",
    "electron:build": "npm run build:web && npm run copy:standalone-assets && npm run copy:prisma-resources && npm run build:packaged-env && npm run check:packaged-env && electron-builder",
    "copy:standalone-assets": "node electron/scripts/copy-standalone-assets.js",
    "copy:prisma-resources": "node electron/scripts/copy-prisma-resources.js",
    "build:packaged-env": "node electron/scripts/build-packaged-env.js",
    "check:packaged-env": "node electron/scripts/check-packaged-env.js",
    "dist:mac": "npm run build:web && npm run copy:standalone-assets && npm run copy:prisma-resources && npm run build:packaged-env && npm run check:packaged-env && electron-builder --mac --publish never",
    "dist:win": "npm run build:web && npm run copy:standalone-assets && npm run copy:prisma-resources && npm run build:packaged-env && npm run check:packaged-env && electron-builder --win nsis"
  },
  "dependencies": {
    "@embedded-postgres/windows-x64": "^17.9.0-beta.17",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^17.9.0-beta.17",
    "pg": "^8.21.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^17.9.0-beta.17",
    "@embedded-postgres/darwin-x64": "^17.9.0-beta.17"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "asar": false,
    "files": [
      "electron/**/*",
      "apps/web/.next/standalone/**/*",
      "apps/web/.next/static/**/*",
      "apps/web/public/**/*",
      "apps/web/package.json",
      "packages/core/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/web/.env.packaged.local",
        "to": "env/.env.local"
      },
      {
        "from": "apps/web/prisma/migrations",
        "to": "prisma/migrations"
      },
      {
        "from": "apps/web/prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}
